#!/usr/bin/env python3

import json
import math
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "0.0.0.0"
PORT = 8765

state = {
    "input_device": None,
    "output_device": None,
    "input_rms": -60.0,
    "input_peak": -60.0,
    "output_rms": -60.0,
    "output_peak": -60.0,
    "input_volume": 0.0,
    "output_volume": 0.0,
    "input_mute": False,
    "output_mute": False,
    "updated": 0,
}


def pactl(*args):
    result = subprocess.run(
        ["pactl", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "pactl failed")

    return result.stdout


def get_devices():
    sources = []
    sinks = []

    try:
        data = json.loads(pactl("-f", "json", "list", "sources"))

        for item in data:
            name = item.get("name")
            description = item.get("description") or name

            if name and not name.endswith(".monitor"):
                sources.append({
                    "name": name,
                    "description": description,
                })
    except Exception:
        pass

    try:
        data = json.loads(pactl("-f", "json", "list", "sinks"))

        for item in data:
            name = item.get("name")
            description = item.get("description") or name

            if name:
                sinks.append({
                    "name": name,
                    "description": description,
                })
    except Exception:
        pass

    return sources, sinks


def get_defaults():
    source = None
    sink = None

    try:
        info = pactl("info")

        for line in info.splitlines():
            if line.startswith("Default Source:"):
                source = line.split(":", 1)[1].strip()

            elif line.startswith("Default Sink:"):
                sink = line.split(":", 1)[1].strip()

    except Exception:
        pass

    return source, sink


def volume_from_pactl(text):
    for token in text.replace(",", " ").split():
        if token.endswith("%"):
            try:
                return float(token[:-1])
            except ValueError:
                pass

    return 0.0


def refresh_devices():
    sources, sinks = get_devices()
    default_source, default_sink = get_defaults()

    source_names = [x["name"] for x in sources]
    sink_names = [x["name"] for x in sinks]

    if state["input_device"] not in source_names:
        state["input_device"] = (
            default_source
            or (source_names[0] if source_names else None)
        )

    if state["output_device"] not in sink_names:
        state["output_device"] = (
            default_sink
            or (sink_names[0] if sink_names else None)
        )


def refresh_controls():
    refresh_devices()

    try:
        if state["input_device"]:
            volume = pactl(
                "get-source-volume",
                state["input_device"],
            )

            state["input_volume"] = round(
                volume_from_pactl(volume),
                1,
            )

            mute = pactl(
                "get-source-mute",
                state["input_device"],
            )

            state["input_mute"] = "yes" in mute.lower()

        if state["output_device"]:
            volume = pactl(
                "get-sink-volume",
                state["output_device"],
            )

            state["output_volume"] = round(
                volume_from_pactl(volume),
                1,
            )

            mute = pactl(
                "get-sink-mute",
                state["output_device"],
            )

            state["output_mute"] = "yes" in mute.lower()

    except Exception:
        pass


def meter_loop():
    while True:
        try:
            refresh_controls()
            state["updated"] = time.time()

        except Exception:
            pass

        time.sleep(0.5)


class Handler(BaseHTTPRequestHandler):

    def send_json(self, obj, status=200):
        body = json.dumps(obj).encode()

        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header(
            "Access-Control-Allow-Headers",
            "Content-Type",
        )
        self.send_header(
            "Access-Control-Allow-Methods",
            "GET, POST, OPTIONS",
        )
        self.send_header(
            "Content-Length",
            str(len(body)),
        )
        self.end_headers()

        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_json({"ok": True})

    def do_GET(self):

        if self.path == "/health":
            self.send_json({"ok": True})
            return

        if self.path == "/state":
            self.send_json(dict(state))
            return

        if self.path == "/devices":
            sources, sinks = get_devices()

            self.send_json({
                "inputs": sources,
                "outputs": sinks,
                "selected_input": state["input_device"],
                "selected_output": state["output_device"],
            })
            return

        self.send_json(
            {"error": "not found"},
            404,
        )

    def do_POST(self):

        if self.path != "/control":
            self.send_json(
                {"error": "not found"},
                404,
            )
            return

        try:
            length = int(
                self.headers.get(
                    "Content-Length",
                    "0",
                )
            )

            data = json.loads(
                self.rfile.read(length) or "{}"
            )

            target = data.get("target")

            if target == "input":

                device = data.get("device")

                if device:
                    pactl(
                        "set-default-source",
                        device,
                    )

                    state["input_device"] = device

                if "volume" in data:
                    volume = max(
                        0,
                        min(
                            100,
                            float(data["volume"]),
                        ),
                    )

                    pactl(
                        "set-source-volume",
                        state["input_device"],
                        f"{volume:.0f}%",
                    )

                if "mute" in data:
                    pactl(
                        "set-source-mute",
                        state["input_device"],
                        "1" if data["mute"] else "0",
                    )

            elif target == "output":

                device = data.get("device")

                if device:
                    pactl(
                        "set-default-sink",
                        device,
                    )

                    state["output_device"] = device

                if "volume" in data:
                    volume = max(
                        0,
                        min(
                            100,
                            float(data["volume"]),
                        ),
                    )

                    pactl(
                        "set-sink-volume",
                        state["output_device"],
                        f"{volume:.0f}%",
                    )

                if "mute" in data:
                    pactl(
                        "set-sink-mute",
                        state["output_device"],
                        "1" if data["mute"] else "0",
                    )

            else:
                self.send_json(
                    {"error": "invalid target"},
                    400,
                )
                return

            refresh_controls()
            self.send_json(dict(state))

        except Exception as exc:
            self.send_json(
                {"error": str(exc)},
                500,
            )

    def log_message(self, *_):
        pass


def main():
    print(
        "=== PulseAudio Meter starting ===",
        flush=True,
    )

    refresh_controls()

    threading.Thread(
        target=meter_loop,
        daemon=True,
    ).start()

    server = ThreadingHTTPServer(
        (HOST, PORT),
        Handler,
    )

    server.serve_forever()


if __name__ == "__main__":
    main()
